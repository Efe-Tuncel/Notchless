<Window x:Class="Notchless.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar — Notchless" Height="640" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F0F10" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9ECAFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <TextBlock Text="Ayarlar" Foreground="White" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="VersionText" Text="v1.2.7" Foreground="#888" FontSize="10" Margin="0,2,0,0"/>

        <TextBlock Style="{StaticResource SectionTitle}" Text="TEMA (10)"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Tema seç — önizleme anında, Kaydet ile kalıcı" Foreground="#888" FontSize="10" Margin="0,0,0,8"/>
                <ComboBox x:Name="ThemePicker" SelectionChanged="ThemePicker_Changed" FontSize="11" Background="#1E1E20" Foreground="White">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding CardBg}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Foreground="#888" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="PreviewIsland" Width="100" Height="28" CornerRadius="14" Background="#1A1A1E" BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Left"/>
                    <Border x:Name="PreviewCard" Width="80" Height="48" CornerRadius="12" Background="#1A1A1E" BorderBrush="#1EFFFFFF" BorderThickness="1" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="GENEL"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="AutoStartCheck" Content="Başlangıçta çalıştır" Foreground="White" FontSize="11" Checked="AutoStart_Checked" Unchecked="AutoStart_Unchecked"/>
                <TextBlock Text="HKCU\Run anahtarına yazılır" Foreground="#666" FontSize="9" Margin="22,2,0,0"/>
                <CheckBox x:Name="ExcludeCaptureCheck2" Content="Ekran görüntüsünden gizle" Foreground="White" FontSize="11" Margin="0,10,0,0" Checked="ExcludeCapture2_Checked" Unchecked="ExcludeCapture2_Unchecked"/>
                <CheckBox x:Name="AudioHookCheck2" Content="Ses tuşlarını yakala" Foreground="White" FontSize="11" Margin="0,10,0,0" Checked="AudioHook2_Checked" Unchecked="AudioHook2_Unchecked"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="BİLDİRİM"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Süre" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    <Slider x:Name="NotifDurationSlider" Minimum="2" Maximum="8" Value="4.5" Width="160" Margin="12,0" IsSnapToTickEnabled="True" TickFrequency="0.5" ValueChanged="NotifDuration_Changed"/>
                    <TextBlock x:Name="NotifDurationText" Text="4.5 sn" Foreground="#9ECAFF" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Ada bildirimlerinin ekranda kalma süresi" Foreground="#666" FontSize="9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="GÜNCELLEME"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Button x:Name="CheckUpdateBtn" Content="⟳ Güncellemeyi denetle" Padding="12,7" Background="#2B5DFF" Foreground="White" BorderThickness="0" Cursor="Hand" Click="CheckUpdate_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="UpdateStatusText" Text="Son kontrol: hiç yapılmadı" Foreground="#666" FontSize="9" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="HAKKINDA"/>
        <TextBlock Text="Notchless — Windows Dynamic Island • Tek exe, MSIX yok • GitHub: Efe-Tuncel/Notchless" Foreground="#666" FontSize="9" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Kaydet" Style="{StaticResource Card}" Padding="16,7" Background="#2B5DFF" Foreground="White" BorderThickness="0" Click="Save_Click" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Kapat" Padding="16,7" Background="#1A1A1E" Foreground="White" BorderBrush="#1EFFFFFF" BorderThickness="1" Click="Close_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
